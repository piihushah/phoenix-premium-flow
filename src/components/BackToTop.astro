---
import { Icon } from "astro-icon/components";
---

<button
  id="btn-back-to-top"
  type="button"
  class="fixed bottom-6 right-6 z-9999 flex h-12 w-12 items-center justify-center rounded-full bg-[#CA9236] text-white shadow-lg transition-all duration-300 opacity-0 pointer-events-none hover:bg-[#B8860B]"
  aria-label="Back to top"
>
  <Icon name="mdi:arrow-up" class="h-6 w-6" />
</button>

<script is:inline>
  const backToTopBtn = document.getElementById("btn-back-to-top");

  function toggleBackToTop() {
    if (!backToTopBtn) return;
    if (window.scrollY > 300) {
      backToTopBtn.classList.remove("opacity-0", "pointer-events-none");
      backToTopBtn.classList.add("opacity-100");
    } else {
      backToTopBtn.classList.add("opacity-0", "pointer-events-none");
      backToTopBtn.classList.remove("opacity-100");
    }
  }
  window.addEventListener("scroll", toggleBackToTop);

  backToTopBtn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  toggleBackToTop();
</script>
