---
import { Icon } from "astro-icon/components";
import reviews from "@data/reviews.ts";
---

<div id="reviews" class="px-6 py-16">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 text-center">
     <p class="text-center text-sm font-bold uppercase tracking-widest text-[#aa7239]">
        What Our Customers Say
      </p>

      <h2 class="mb-4 mt-2 text-center font-serif text-3xl font-bold text-slate-950 md:text-4xl">
       Loved by Our Customers
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        reviews.map((review) => (
          <article
            class="flex h-full flex-col rounded-2xl border border-slate-200
                   bg-white p-6 shadow-sm transition duration-300
                   hover:-translate-y-1 hover:shadow-lg"
          >
            <!-- Stars -->
            <div
              class="flex gap-1 text-amber-400"
              aria-label={`${review.rating} out of 5 stars`}
            >
              {
                Array.from({ length: review.rating }).map(() => (
                  <Icon
                    name="mdi:star"
                    class="size-5"
                    aria-hidden="true"
                  />
                ))
              }
            </div>

            <!-- Review -->
            <blockquote class="mt-5 flex-1 leading-7 text-slate-600">
              “{review.review}”
            </blockquote>

            <!-- Customer -->
            <div class="mt-6 flex items-center gap-4 border-t border-slate-100 pt-5">
              <div
                class="flex size-12 shrink-0 items-center justify-center
                       rounded-full bg-[#fbf7f1] font-bold text-[#aa7239]"
                aria-hidden="true"
              >
                {review.initials}
              </div>

              <div>
                <p class="font-bold text-slate-900">
                  {review.name}
                </p>

              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</div>