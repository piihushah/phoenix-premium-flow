{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components/*": ["src/components/*"],
      "@data/*": ["src/data/*"],
      "@layouts/*": ["src/layouts/*"],
      "@utilities/*": ["src/utilities/*"],
      "@styles/*": ["src/styles/*"],
      "@sections/*": ["src/sections/*"],
      "@images/*": ["src/images/*"]
    }
  }
}